# Copy to .env and set a local-only password before starting Docker or the backend.
# Use plain KEY=value lines without quotes or spaces; use an alphanumeric password.
POSTGRES_DB=bizorder
POSTGRES_USER=bizorder
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Keep the database name and host port consistent with the values above.
DB_URL=jdbc:postgresql://localhost:5432/bizorder
